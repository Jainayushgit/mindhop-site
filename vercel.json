{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|mp3|webp|jpg|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sales/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sprout-buddy/pitch{/}?",
      "destination": "https://youngturings.com/sprout-buddy/pitch.html",
      "permanent": false
    },
    {
      "source": "/sprout-buddy/pitch.html",
      "destination": "https://youngturings.com/sprout-buddy/pitch.html",
      "permanent": false
    },
    {
      "source": "/sprout-buddy{/}?",
      "destination": "https://youngturings.com/sprout-buddy/",
      "permanent": false
    },
    {
      "source": "/sprout-buddy/index.html",
      "destination": "https://youngturings.com/sprout-buddy/",
      "permanent": false
    }
  ]
}